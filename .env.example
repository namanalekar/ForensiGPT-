# ==============================================================================
# ForensiGPT Environment Configuration
# ==============================================================================

# Google Gemini AI Configuration
# The model name is never hardcoded. Default: gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Security & Storage Configuration
# Maximum file upload size in bytes (Default: 26214400 = 25 MB)
MAX_UPLOAD_SIZE_BYTES=26214400

# Retention period in hours before automatic purge of files and reports (Default: 24h)
RETENTION_HOURS=24

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Rate Limiting (Requests per minute per IP)
RATE_LIMIT_PER_MINUTE=120

# Optional Hash Reputation API (e.g. VirusTotal)
VIRUSTOTAL_API_KEY=
